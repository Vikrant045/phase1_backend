# Server Port
PORT=5000

# PostgreSQL connection used by the RUNNING API (Neon pooler endpoint)
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?sslmode=require"

# PostgreSQL connection used by the PRISMA CLI (migrate/studio/seed) — DIRECT endpoint, no "-pooler"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"